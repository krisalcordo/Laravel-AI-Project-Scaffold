#!/usr/bin/env bash

set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

required=(
    AGENTS.md
    PRODUCT.md
    DESIGN.md
    ARCHITECTURE.md
    .github/pull_request_template.md
    .github/workflows/pr-contract.yml
    .agents/skills/impeccable/SKILL.md
    .agents/skills/impeccable/reference/audit.md
    .agents/skills/impeccable/reference/polish.md
    .agents/skills/impeccable/scripts/load-context.mjs
    bin/test-installer
    bin/test-scaffold-pr-contract
    docs/WORKTREES.md
    tools/scaffold-pr-contract.php
    template/AGENTS.md
    template/PRODUCT.md
    template/DESIGN.md
    template/ARCHITECTURE.md
    template/.project-scaffold
    template/.github/pull_request_template.md
    template/.github/workflows/tests.yml
    template/.github/workflows/pr-contract.yml
    template/.ddev/config.yaml
    template/.ddev/commands/web/worktree-setup
    template/.ddev/commands/web/preview
    template/.ddev/commands/web/test-postgres
    template/.ddev/generate-preview-slots.sh
    template/.ddev/lib/worktree-paths.sh
    template/docs/project/PROJECT.md
    template/docs/project/WORKTREES.md
    template/tools/pr-contract/validate.php
    template/tools/pr-contract/config.php
    template/tools/pr-contract/tests/run.php
)

for file in "${required[@]}"; do
    if [ ! -f "$file" ]; then
        echo "Missing required scaffold file: $file" >&2
        exit 1
    fi
done

bash -n bin/apply-scaffold
bash -n bin/check-scaffold
bash -n bin/test-installer
bash -n bin/test-scaffold-pr-contract
find template/.ddev -type f \( -name '*.sh' -o -path '*/commands/*' \) -print0 \
    | xargs -0 -n1 bash -n

php template/tools/pr-contract/tests/run.php
bin/test-scaffold-pr-contract
node .agents/skills/impeccable/scripts/load-context.mjs >/dev/null
IMPECCABLE_CONTEXT_DIR=template node .agents/skills/impeccable/scripts/load-context.mjs >/dev/null
bin/test-installer

if command -v rg >/dev/null 2>&1; then
    leak_output=$(rg --hidden -n 'formz|Ollivy|research-stores|demo@formz' . \
        -g '!bin/check-scaffold' -g '!docs/SOURCE-NOTES.md' -g '!README.md' -g '!.git/**' || true)
else
    leak_output=$(grep -RInE 'formz|Ollivy|research-stores|demo@formz' . \
        --exclude=check-scaffold --exclude=README.md --exclude=SOURCE-NOTES.md \
        --exclude-dir=.git || true)
fi

if [ -n "$leak_output" ]; then
    echo "$leak_output"
    echo "Product-specific source terms leaked into reusable files." >&2
    exit 1
fi

echo "Scaffold checks passed."
